+    // Adopt the named Unix listener created by the systemd socket unit.
+    fn start_activated_unix(&self, mut server: ArcServer) -> anyhow::Result<()> {
+        use std::os::fd::FromRawFd;
+
+        let name = self.name().to_string();
+        let mut descriptors = sd_notify::listen_fds_with_names()?
+            .filter(|(_, fd_name)| fd_name == &name);
+        let Some((fd, _)) = descriptors.next() else {
+            return Ok(());
+        };
+        anyhow::ensure!(descriptors.next().is_none(), "multiple Unix listeners for {name}");
+        // SAFETY: sd-notify validated these inherited descriptors for this PID;
+        // this HTTP server is the sole owner of the descriptor named for it.
+        let listener = unsafe { std::os::unix::net::UnixListener::from_raw_fd(fd) };
+        listener.local_addr().context("activation socket is not AF_UNIX")?;
+        listener.set_nonblocking(true)?;
+        let listener = UnixListener::from_std(listener)?;
+        let mut reload = self.reload_sender.subscribe();
+        self.server_stats.set_online();
+        tokio::spawn(async move {
+            loop {
+                tokio::select! {
+                    command = reload.recv() => match command {
+                        Ok(ServerReloadCommand::ReloadVersion(_)) => {
+                            server = crate::serve::get_or_insert_default(server.name());
+                        }
+                        Ok(ServerReloadCommand::UpdateInPlace(_)) => {},
+                        Err(broadcast::error::RecvError::Lagged(_)) => {},
+                        _ => break,
+                    },
+                    result = listener.accept() => {
+                        let (stream, _) = match result {
+                            Ok(accepted) => accepted,
+                            Err(error) => {
+                                log::error!("Unix proxy accept failed: {error}");
+                                break;
+                            }
+                        };
+                        let server = Arc::clone(&server);
+                        tokio::spawn(async move {
+                            // Unix peers have no IP address; use loopback for accounting.
+                            let address = SocketAddr::from(([127, 0, 0, 1], 0));
+                            server.run_unix_task(stream, ClientConnectionInfo::new(address, address)).await;
+                        });
+                    }
+                }
+            }
+        });
+        Ok(())
+    }

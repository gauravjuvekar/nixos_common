(defwidget bar-inhibitor []
  (button :class "idle" :style {inhibited ? "background: #ecf0f1;" : ""}
    :onclick "@backend@ inhibit" :tooltip "Toggle idle inhibition"
    (image :path {inhibited ? "@icons@/idle-inhibited.svg" : "@icons@/idle-enabled.svg"}
      :image-width 16 :image-height 16 :halign "center" :valign "center")))

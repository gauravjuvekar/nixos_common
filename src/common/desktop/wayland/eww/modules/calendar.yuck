(defwidget world-calendar [output]
  (box :class "calendar-popup" :orientation "vertical" :space-evenly false :spacing 10
    (box :class "zone-table" :orientation "vertical" :space-evenly false
      (for zone in {timezone_names}
        (button :class {(clock_selections[output] ?: clock_selections[""]) == zone ? "zone selected" : "zone"}
          :onclick "@backend@ select-timezone '${output}' '${zone}'"
          (box :space-evenly false :spacing 16
            (label :class "zone-name" :text {zone} :xalign 0 :unindent false)
            (label :class "zone-time" :text {timezone_times[zone]} :xalign 0 :unindent false)))))
    (eventbox :onscroll "@backend@ calendar '${output}' {}" :onrightclick "@backend@ calendar-mode '${output}'"
      (label :class "year-calendar" :text {calendar_texts[output] ?: calendar_texts[""]}
        :xalign 0 :justify "left" :unindent false :wrap false))))

(defwindow calendar-popup [output]
  :monitor output
  :geometry (geometry :x "0px" :y "0px" :width "0px" :height "0px" :anchor "top right")
  :resizable false
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (world-calendar :output output))

(defwidget world-clock [output]
  (eventbox :onscroll "@backend@ timezone {}" :onmiddleclick "@backend@ timezone up"
    :onclick "${EWW_CMD} open calendar-popup --toggle --id 'calendar-${output}' --arg 'output=${output}'"
    :onrightclick "@backend@ calendar-mode"
    (label :class "clock" :text {status.clock.text} :unindent false)))

(defwidget bar-battery []
  (eventbox :visible @laptop@ :onscroll "@backend@ brightness {}"
    (box :class "battery ${status.battery.state}"
      :space-evenly false :spacing 4 :tooltip {status.battery.tooltip}
      (label :text {status.battery.text})
      (image :path "@icons@/${status.battery.icon}.svg"
        :image-width 16 :image-height 16 :valign "center"))))

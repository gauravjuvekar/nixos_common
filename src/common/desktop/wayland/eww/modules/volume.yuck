(defwidget bar-volume []
  (eventbox :onscroll "@backend@ volume {}"
    (button :class "volume ${volume.state}" :onclick "@sound@ &"
      :onmiddleclick "@backend@ mute" :tooltip {volume.tooltip}
      (box :space-evenly false :spacing 3
        (image :class "volume-icon" :path "@icons@/${volume.icon}.svg"
          :image-width 16 :image-height 16 :valign "center")
        (label :text {volume.percentage} :unindent false)))))

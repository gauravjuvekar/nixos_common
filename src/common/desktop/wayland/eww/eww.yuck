(defvar workspaces '[]')
(defvar windows '[]')
(defvar titles '[]')
(defvar battery '{"text":"?%","icon":"battery-empty","state":"unknown","tooltip":""}')
(defvar keyboard '[]')
(defvar bluetooth '{"text":"?","state":"unknown","tooltip":""}')
(defvar volume '{"icon":"volume","percentage":"  ?%","state":"unknown","tooltip":""}')
(defvar inhibited 'false')
(defvar failed '{"text":"?/?","state":"degraded","visible":false,"tooltip":""}')
(defvar calendar_texts '{}')
(defvar clock_selections '{}')
(defvar timezone_names '[]')
(deflisten timezone_times :initial '{}' "@backend@ watch --eww-config .")

(defwidget panel [output]
  (centerbox :class "panel"
    (desktop :output output)
    (desktop-title :output output)
    (box :class "modules-right" :space-evenly false :halign "end" :spacing 0
      (bar-tray)
      (bar-battery)
      (bar-keyboard)
      (bar-bluetooth)
      (bar-volume)
      (world-clock :output output)
      (bar-inhibitor)
      (bar-failed-units))))

(defwindow bar [output]
  :monitor output
  :geometry (geometry :x "0%" :y "0px" :width "100%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable "none"
  (panel :output output))
